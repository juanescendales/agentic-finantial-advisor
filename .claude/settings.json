{
  "disableAllHooks": false,
  "disableBundledSkills": true,
  "enabledPlugins": {},
  "enableAllProjectMcpServers": false,
  "disabledMcpjsonServers": [],
  "hooks": {
      "PostToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [
            { "type": "command", "command": "bash .agents/hooks/run-black.sh" },
            { "type": "command", "command": "bash .agents/hooks/run-ruff.sh" },
            { "type": "command", "command": "bash .agents/hooks/run-mypy.sh" }
          ]
        }
      ]
    }
}
